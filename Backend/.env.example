PORT=5000
NODE_ENV=development

# MongoDB Atlas URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/prepzone

# JWT
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# Allowed frontend origin
CLIENT_URL=http://localhost:5173

# Mistral AI (optional - falls back to rule-based if missing/expired)
MISTRAL_API_KEY=your_mistral_api_key_here
